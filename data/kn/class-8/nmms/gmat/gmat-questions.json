      "id": "GMAT-IF-0053",
      "difficulty": "medium",
      "question": {
        "kn": "ಬ್ಯಾಡ್ಮಿಂಟನ್ ಆಟಗಾರರೂ ಆಗಿರುವ ಕ್ರಿಕೆಟ್ ಆಟಗಾರರ ಒಟ್ಟು ಸಂಖ್ಯೆ ಎಷ್ಟು?",
        "en": "The total number of cricket players who are badminton players."
      },
      "options": [
        {
          "kn": "22",
          "en": "22"
        },
        {
          "kn": "26",
          "en": "26"
        },
        {
          "kn": "42",
          "en": "42"
        },
        {
          "kn": "32",
          "en": "32"
        }
      ],
      "correctIndex": 0,
      "explanation": {
